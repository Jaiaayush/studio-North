# .env.example — a TEMPLATE. It holds no real secrets and is safe to share.
# To use it: copy this file, name the copy ".env.local", and fill in the values.
# ".env.local" is ignored by git, so your real keys never get uploaded.

# Your Resend API key (from https://resend.com). Leave empty in development:
# enquiries are then printed in the server terminal instead of emailed.
RESEND_API_KEY=

# The inbox that should receive website enquiries.
CONTACT_TO_EMAIL=

# The "from" address. Must be on a domain you have verified in Resend.
# Example: Studio North <enquiries@yourdomain.co.uk>
CONTACT_FROM_EMAIL=
